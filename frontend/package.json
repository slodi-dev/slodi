{
  "name": "slodi",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build --turbopack",
    "start": "next start",
    "lint": "eslint && prettier --check .",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "deploy-prod": "vercel --prod",
    "test": "vitest run --project unit",
    "test:watch": "vitest --project unit",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build -o storybook-static",
    "test:stories": "vitest run --project \"storybook-*\"",
    "check:tokens": "node scripts/check-tokens.mjs",
    "check:stories": "node scripts/check-stories.mjs"
  },
  "dependencies": {
    "@auth0/nextjs-auth0": "^4.14.0",
    "@hookform/resolvers": "^5.2.2",
    "@vercel/analytics": "^1.6.1",
    "audit": "^0.0.6",
    "clsx": "^2.1.1",
    "lucide-react": "^0.555.0",
    "next": "^15.5.7",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "react-hook-form": "^7.70.0",
    "tailwind-merge": "^3.4.0",
    "zod": "^4.3.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@storybook/addon-a11y": "^10.6.1",
    "@storybook/addon-docs": "^10.6.1",
    "@storybook/addon-vitest": "^10.6.1",
    "@storybook/nextjs-vite": "^10.6.1",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/browser": "^3.2.4",
    "eslint": "^9.39.3",
    "eslint-config-next": "^15.5.12",
    "eslint-config-prettier": "^10.1.8",
    "jose": "^6.2.12",
    "jsdom": "^25.0.1",
    "playwright": "^1.64.0",
    "prettier": "^3.8.1",
    "storybook": "^10.6.1",
    "typescript": "^5",
    "vite": "^6.4.4",
    "vitest": "^3.2.4"
  }
}

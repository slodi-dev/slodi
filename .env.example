# Docker Compose settings only, not passed into containers.
# Service config: backend/.env and frontend/.env

# API URL as the browser sees it (baked into the frontend build)
NEXT_PUBLIC_API_URL=http://localhost:8000

# Host ports (defaults: 8000, 3000, 5432)
# BACKEND_PORT=8000
# FRONTEND_PORT=3000
DB_EXPOSE_PORT=5432

# Postgres password on first start; must match backend/.env
# DB_PASSWORD=slodi_password

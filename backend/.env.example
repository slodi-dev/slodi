ENV = "development"

# Database configuration (as reached from your machine; Docker overrides host/port).
# The Postgres container reads the POSTGRES_* values too, when it creates its volume.
POSTGRES_DB = "slodi_db"
POSTGRES_USER = "slodi_user"
POSTGRES_PASSWORD = "slodi_password"
DB_PORT = "5432"
DB_HOST = "localhost"

# Auth0 configuration
AUTH0_DOMAIN = "your-tenant.eu.auth0.com"
AUTH0_AUDIENCE = "https://api.slodi.is"
AUTH0_ALGORITHMS = '["RS256"]'
# AUTH0_DEBUG = false

# CORS configuration
CORS_ORIGINS = '["http://localhost:3000", "https://slodi.is"]'

# Logging
LOGGER_LEVEL = "INFO"
# LOGGER_FILE = ""

# Cache (default: in-process memory; set to "redis" for multi-worker deployments)
CACHE_BACKEND = "memory"
# REDIS_HOST = "localhost"
# REDIS_PORT = 6379
# CACHE_USER_TTL_SECONDS = 300
# CACHE_MEMBERSHIP_TTL_SECONDS = 120
# CACHE_TAGS_TTL_SECONDS = 600
# RATE_LIMIT_MAX_WINDOW_SECONDS = 3600

# Blob Storage (one account, two containers)
AZURE_STORAGE_ACCOUNT = "your_storage_account"
AZURE_STORAGE_KEY = "your_storage_key"
# Public container (anonymous blob read) — images rendered inline on the site.
AZURE_STORAGE_CONTAINER_IMAGES = "images"
# Private container (no anonymous access) — documents served via download SAS.
AZURE_STORAGE_CONTAINER_DOCUMENTS = "documents"

# Resend (email)
RESEND_API_KEY = "re_your_api_key"
# RESEND_FROM_EMAIL = "Slóði <noreply@slodi.is>"

# Seed: comma-separated emails promoted to admin / moderator on `make seed`
ADMIN_EMAILS = "admin@example.com,another@example.com"
# MODERATOR_EMAILS = ""

# Everything below is optional; the defaults work for local development.

# DEFAULT_WORKSPACE_ID is read from seed_output.json, written by the seed.
# Docker sets SEED_OUTPUT_DIR to the shared seed volume; locally it is the backend folder.
# SEED_OUTPUT_DIR = ""
# DEFAULT_WORKSPACE_ID = ""

# Game run token signing key. Required outside development (production sets it on deploy).
# GAME_TOKEN_SECRET = ""

# Feature flags
# HEIDURSORDLA_ENABLED = false

# Unsafe-report escalation emails (default: ADMIN_EMAILS)
# MODERATION_EMAILS = ""

# Base URLs for links in outgoing email (default: production)
# PUBLIC_SITE_URL = "http://localhost:3000"
# PUBLIC_API_URL = "http://localhost:8000"
